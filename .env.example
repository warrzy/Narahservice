# URL publique du site (utilisée pour SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://votredomaine.com

# Numéro WhatsApp principal (format international, chiffres uniquement)
# Exemple Burkina Faso : 22678024690
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contact affiché (facultatif)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- SMTP (obligatoire pour l'envoi réel des devis) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NARAH SERVICE <noreply@votredomaine.com>"
MAIL_TO=contact@votredomaine.com
